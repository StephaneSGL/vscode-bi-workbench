{
  "name": "vscode-bi-workbench",
  "displayName": "BI Workbench",
  "description": "Local-first business intelligence projects, SQL analytics, semantic models, interactive dashboards, and GitHub Copilot assistance inside VS Code.",
  "version": "0.3.0",
  "publisher": "stephanesgl",
  "license": "MIT",
  "icon": "media/bi-workbench-logo.png",
  "galleryBanner": {
    "color": "#0B1020",
    "theme": "dark"
  },
  "homepage": "https://github.com/StephaneSGL/vscode-bi-workbench#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/StephaneSGL/vscode-bi-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/StephaneSGL/vscode-bi-workbench/issues"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Data Science",
    "Visualization",
    "AI",
    "Chat"
  ],
  "keywords": [
    "business intelligence",
    "analytics",
    "dashboard",
    "duckdb",
    "csv",
    "excel",
    "github copilot"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": false,
      "description": "BI Workbench reads local data files and executes SQL, so the workspace must be trusted."
    }
  },
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "biWorkbench.open",
        "title": "Open BI Workbench",
        "category": "BI Workbench",
        "icon": "$(dashboard)"
      },
      {
        "command": "biWorkbench.createProject",
        "title": "Create New Project",
        "category": "BI Workbench",
        "icon": "$(new-folder)"
      },
      {
        "command": "biWorkbench.openProject",
        "title": "Open BI Project",
        "category": "BI Workbench",
        "icon": "$(folder-opened)"
      },
      {
        "command": "biWorkbench.importData",
        "title": "Import Data",
        "category": "BI Workbench",
        "icon": "$(cloud-download)"
      },
      {
        "command": "biWorkbench.saveProject",
        "title": "Save BI Project",
        "category": "BI Workbench",
        "icon": "$(save)"
      },
      {
        "command": "biWorkbench.exportReport",
        "title": "Export Active Report",
        "category": "BI Workbench",
        "icon": "$(export)"
      },
      {
        "command": "biWorkbench.exportPowerBiProject",
        "title": "Export Power BI Desktop Project (PBIP)",
        "category": "BI Workbench",
        "icon": "$(file-symlink-file)"
      },
      {
        "command": "biWorkbench.showLogs",
        "title": "Show Logs",
        "category": "BI Workbench",
        "icon": "$(output)"
      },
      {
        "command": "biWorkbench.openHelp",
        "title": "Open Help",
        "category": "BI Workbench",
        "icon": "$(question)"
      },
      {
        "command": "biWorkbench.openProjectFile",
        "title": "Open in BI Workbench",
        "category": "BI Workbench"
      }
    ],
    "keybindings": [
      {
        "command": "biWorkbench.open",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "biWorkbench.projects",
          "name": "BI Workbench: Project",
          "icon": "$(project)",
          "visibility": "visible"
        },
        {
          "id": "biWorkbench.model",
          "name": "BI Workbench: Semantic Model",
          "icon": "$(type-hierarchy)",
          "visibility": "visible"
        },
        {
          "id": "biWorkbench.reports",
          "name": "BI Workbench: Reports",
          "icon": "$(graph)",
          "visibility": "visible"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "biWorkbench.projects",
        "contents": "No BI project is open.\n[Create a project](command:biWorkbench.createProject)\n[Open a project](command:biWorkbench.openProject)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "biWorkbench.open",
          "when": "view =~ /biWorkbench\\./",
          "group": "navigation@1"
        },
        {
          "command": "biWorkbench.importData",
          "when": "view == biWorkbench.projects",
          "group": "navigation@2"
        },
        {
          "command": "biWorkbench.saveProject",
          "when": "view =~ /biWorkbench\\./",
          "group": "navigation@3"
        },
        {
          "command": "biWorkbench.exportPowerBiProject",
          "when": "view == biWorkbench.reports",
          "group": "navigation@4"
        }
      ],
      "explorer/context": [
        {
          "command": "biWorkbench.openProjectFile",
          "when": "resourceExtname == .json && resourceFilename =~ /\\.bi\\.json$/",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "BI Workbench",
      "properties": {
        "biWorkbench.previewRowLimit": {
          "type": "number",
          "default": 500,
          "minimum": 10,
          "maximum": 10000,
          "description": "Maximum rows returned by a table preview."
        },
        "biWorkbench.queryRowLimit": {
          "type": "number",
          "default": 5000,
          "minimum": 100,
          "maximum": 100000,
          "description": "Maximum rows returned to the workbench for an ad-hoc query."
        },
        "biWorkbench.copilotDataSharing": {
          "type": "string",
          "enum": [
            "schema",
            "aggregates",
            "samples"
          ],
          "enumDescriptions": [
            "Share only table, column, relationship, measure, and report metadata.",
            "Also share bounded aggregate summaries. Group keys and order statistics can still disclose individual values.",
            "Also share a bounded sample of raw rows. This can disclose sensitive values to the selected model provider."
          ],
          "default": "schema",
          "description": "Data context BI Workbench may send to the language model when @bi is explicitly used."
        },
        "biWorkbench.maxCopilotSampleRows": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "maximum": 100,
          "description": "Maximum raw rows included when copilotDataSharing is set to samples."
        },
        "biWorkbench.autoSave": {
          "type": "boolean",
          "default": true,
          "description": "Persist project metadata after each successful change."
        }
      }
    },
    "languages": [
      {
        "id": "bi-workbench-project",
        "aliases": [
          "BI Workbench Project"
        ],
        "extensions": [
          ".bi.json"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "*.bi.json",
        "url": "./schemas/project.schema.json"
      }
    ],
    "chatParticipants": [
      {
        "id": "vscode-bi-workbench.bi",
        "fullName": "BI Workbench",
        "name": "bi",
        "description": "Design queries, analyses, measures, reports, and visualizations for the active BI project.",
        "isSticky": true,
        "commands": [
          {
            "name": "sql",
            "description": "Generate or explain a DuckDB SQL query for the active project"
          },
          {
            "name": "analyze",
            "description": "Analyze the active project using the configured privacy level"
          },
          {
            "name": "report",
            "description": "Propose a complete report backed by real project fields"
          },
          {
            "name": "visual",
            "description": "Choose and configure an appropriate visualization"
          },
          {
            "name": "powerbi",
            "description": "Build and export a real Power BI Desktop Project (PBIP/PBIR/TMDL)"
          }
        ]
      }
    ],
    "languageModelTools": [
      {
        "name": "vscode-bi-workbench_getProjectSchema",
        "displayName": "Get BI Project Schema",
        "modelDescription": "Returns the active BI Workbench project's tables, columns, relationships, measures, and reports without raw data values. Use it before writing project-specific SQL or report suggestions.",
        "userDescription": "Read the active BI project's semantic metadata",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "biProjectSchema",
        "icon": "$(database)",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "vscode-bi-workbench_queryProject",
        "displayName": "Query BI Project",
        "modelDescription": "Executes one bounded read-only query against the active BI Workbench project. It is disabled in schema mode; aggregate mode accepts a conservative aggregate-only SELECT shape, while samples mode permits bounded raw rows.",
        "userDescription": "Run a bounded read-only query against the active BI project",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "biQuery",
        "icon": "$(run-all)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "sql": {
              "type": "string",
              "description": "A single DuckDB SELECT or WITH query. No writes, file readers, network functions, or extension commands."
            },
            "purpose": {
              "type": "string",
              "description": "Short explanation of why this query is needed."
            }
          },
          "required": [
            "sql",
            "purpose"
          ]
        }
      },
      {
        "name": "vscode-bi-workbench_configureVisual",
        "displayName": "Configure BI Visual",
        "modelDescription": "Creates or updates one BI Workbench visual after explicit user confirmation. The extension validates the complete configuration and executes the bounded DuckDB visual query before committing it.",
        "userDescription": "Apply a validated chart or table configuration to a report page",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "biConfigureVisual",
        "icon": "$(graph)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "reportId": {
              "type": "string",
              "description": "Existing report ID from the BI project schema tool."
            },
            "pageId": {
              "type": "string",
              "description": "Existing page ID from the BI project schema tool."
            },
            "purpose": {
              "type": "string",
              "description": "Short explanation of the analytical purpose."
            },
            "visual": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Use a new UUID to add, or an existing visual ID to update."
                },
                "title": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "table",
                    "kpi",
                    "bar",
                    "horizontalBar",
                    "line",
                    "area",
                    "pie",
                    "donut",
                    "scatter",
                    "slicer"
                  ]
                },
                "tableId": {
                  "type": "string"
                },
                "categoryField": {
                  "type": "string"
                },
                "seriesField": {
                  "type": "string"
                },
                "valueField": {
                  "type": "string"
                },
                "measureId": {
                  "type": "string"
                },
                "aggregation": {
                  "type": "string",
                  "enum": [
                    "none",
                    "count",
                    "countDistinct",
                    "sum",
                    "avg",
                    "min",
                    "max"
                  ]
                },
                "columns": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "limit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                },
                "width": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12
                },
                "height": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 12
                },
                "sortField": {
                  "type": "string"
                },
                "sortBy": {
                  "type": "string",
                  "enum": [
                    "auto",
                    "category",
                    "value"
                  ]
                },
                "sortDirection": {
                  "type": "string",
                  "enum": [
                    "asc",
                    "desc"
                  ]
                },
                "color": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "backgroundColor": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "showLegend": {
                  "type": "boolean"
                },
                "legendPosition": {
                  "type": "string",
                  "enum": [
                    "top",
                    "right",
                    "bottom",
                    "left"
                  ]
                },
                "showLabels": {
                  "type": "boolean"
                },
                "smooth": {
                  "type": "boolean"
                },
                "numberFormat": {
                  "type": "string",
                  "enum": [
                    "auto",
                    "number",
                    "integer",
                    "currency",
                    "percent",
                    "date",
                    "datetime",
                    "text"
                  ]
                },
                "currency": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$"
                },
                "decimals": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 6
                },
                "interactionMode": {
                  "type": "string",
                  "enum": [
                    "filter",
                    "none"
                  ]
                }
              },
              "required": [
                "id",
                "title",
                "type",
                "tableId"
              ]
            }
          },
          "required": [
            "reportId",
            "pageId",
            "purpose",
            "visual"
          ]
        }
      },
      {
        "name": "vscode-bi-workbench_createReport",
        "displayName": "Create BI Report",
        "modelDescription": "Creates a new BI Workbench report and its first page after explicit user confirmation. Returns stable report and page IDs for subsequent visual configuration.",
        "userDescription": "Create a report and first page in the active BI project",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "biCreateReport",
        "icon": "$(dashboard)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Unique report name."
            },
            "description": {
              "type": "string",
              "description": "Optional report purpose and audience."
            },
            "pageName": {
              "type": "string",
              "description": "Name of the first report page."
            },
            "pageDescription": {
              "type": "string",
              "description": "Optional first-page description."
            },
            "purpose": {
              "type": "string",
              "description": "Short explanation of why the report is being created."
            }
          },
          "required": [
            "name",
            "pageName",
            "purpose"
          ]
        }
      },
      {
        "name": "vscode-bi-workbench_exportPowerBiProject",
        "displayName": "Export Power BI Desktop Project",
        "modelDescription": "Exports the active BI Workbench project as a real Power BI Desktop Project: PBIP shortcut, PBIR report definitions, TMDL semantic model, relationships, safely translated measures, interactive visuals, and complete local CSV table copies. It always asks the user to select a local parent folder and requires confirmation; it never accepts a filesystem path from the model and never claims to generate proprietary PBIX directly.",
        "userDescription": "Build a Power BI Desktop Project from the active BI project",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "biExportPowerBI",
        "icon": "$(file-symlink-file)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "purpose": {
              "type": "string",
              "description": "Short explanation of why the Power BI project is being exported."
            }
          },
          "required": [
            "purpose"
          ]
        }
      }
    ]
  },
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "build": "node ./esbuild.mjs",
    "build:watch": "node ./esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:ui": "vitest run tests/ui",
    "test:extension": "npm run build && node ./dist/test/runExtensionTests.js",
    "validate": "npm run typecheck && npm run lint && npm run test && npm run build",
    "package": "npm run validate && node ./scripts/collectLicenses.mjs && node ./scripts/ensureArtifacts.mjs && vsce package --out ./artifacts/vscode-bi-workbench-0.3.0.vsix && node ./scripts/writeChecksum.mjs",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.5-r.3",
    "sql.js": "1.14.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@microsoft/powerbi-report-authoring-cli": "0.1.4",
    "@types/node": "22.20.0",
    "@types/sql.js": "1.4.11",
    "@types/vscode": "1.125.0",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "echarts": "6.1.0",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "fflate": "0.8.3",
    "happy-dom": "20.11.1",
    "read-excel-file": "8.0.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  }
}
