{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/StephaneSGL/vscode-bi-workbench/schemas/project.schema.json",
  "title": "BI Workbench Project",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "createdAt",
    "updatedAt",
    "sources",
    "tables",
    "relationships",
    "measures",
    "queries",
    "reports",
    "theme"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/table"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "measures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/measure"
      }
    },
    "queries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/query"
      }
    },
    "reports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/report"
      }
    },
    "theme": {
      "$ref": "#/$defs/theme"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "displayFormat": {
      "enum": ["auto", "number", "integer", "currency", "percent", "date", "datetime", "text"]
    },
    "filterOperator": {
      "enum": ["eq", "neq", "contains", "gt", "gte", "lt", "lte", "between", "isNull", "isNotNull"]
    },
    "transformation": {
      "oneOf": [
        {
          "type": "object",
          "required": ["id", "label", "type", "columns"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "label": { "type": "string", "minLength": 1, "maxLength": 200 },
            "type": { "const": "select" },
            "columns": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["id", "label", "type", "column", "newName"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "label": { "type": "string", "minLength": 1, "maxLength": 200 },
            "type": { "const": "rename" },
            "column": { "type": "string", "minLength": 1 },
            "newName": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["id", "label", "type", "column", "dataType"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "label": { "type": "string", "minLength": 1, "maxLength": 200 },
            "type": { "const": "cast" },
            "column": { "type": "string", "minLength": 1 },
            "dataType": { "enum": ["VARCHAR", "BIGINT", "DOUBLE", "BOOLEAN", "DATE", "TIMESTAMP"] }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["id", "label", "type", "column", "operator"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "label": { "type": "string", "minLength": 1, "maxLength": 200 },
            "type": { "const": "filter" },
            "column": { "type": "string", "minLength": 1 },
            "operator": { "$ref": "#/$defs/filterOperator" },
            "value": {},
            "secondValue": {}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["id", "label", "type", "column", "value"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "label": { "type": "string", "minLength": 1, "maxLength": 200 },
            "type": { "const": "fillNull" },
            "column": { "type": "string", "minLength": 1 },
            "value": {}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["id", "label", "type"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "label": { "type": "string", "minLength": 1, "maxLength": 200 },
            "type": { "const": "deduplicate" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["id", "label", "type", "column", "direction"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "label": { "type": "string", "minLength": 1, "maxLength": 200 },
            "type": { "const": "sort" },
            "column": { "type": "string", "minLength": 1 },
            "direction": { "enum": ["asc", "desc"] }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["id", "label", "type", "column", "find", "replacement", "mode"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "label": { "type": "string", "minLength": 1, "maxLength": 200 },
            "type": { "const": "replace" },
            "column": { "type": "string", "minLength": 1 },
            "find": {},
            "replacement": {},
            "mode": { "enum": ["exact", "substring"] }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["id", "label", "type", "column", "part", "newName"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "label": { "type": "string", "minLength": 1, "maxLength": 200 },
            "type": { "const": "datePart" },
            "column": { "type": "string", "minLength": 1 },
            "part": { "enum": ["year", "quarter", "month", "week", "day", "dayOfWeek", "hour"] },
            "newName": { "type": "string", "minLength": 1, "maxLength": 512 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["id", "label", "type", "groupBy", "aggregations"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "label": { "type": "string", "minLength": 1, "maxLength": 200 },
            "type": { "const": "group" },
            "groupBy": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "aggregations": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["column", "function", "name"],
                "properties": {
                  "column": { "type": "string", "minLength": 1 },
                  "function": { "enum": ["count", "countDistinct", "sum", "avg", "min", "max"] },
                  "name": { "type": "string", "minLength": 1, "maxLength": 512 }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name",
        "location",
        "importedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "csv",
            "tsv",
            "json",
            "jsonl",
            "parquet",
            "xlsx",
            "duckdb",
            "sqlite"
          ]
        },
        "name": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "importedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "column": {
      "type": "object",
      "required": [
        "name",
        "dataType",
        "nullable"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "dataType": {
          "type": "string"
        },
        "nullable": {
          "type": "boolean"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "hidden": {
          "type": "boolean"
        },
        "semanticType": {
          "enum": ["auto", "category", "measure", "date", "geography", "identifier"]
        },
        "format": {
          "$ref": "#/$defs/displayFormat"
        }
      },
      "additionalProperties": false
    },
    "table": {
      "type": "object",
      "required": [
        "id",
        "name",
        "physicalName",
        "kind",
        "columns",
        "rowCount"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "physicalName": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "imported",
            "derived"
          ]
        },
        "sourceId": {
          "$ref": "#/$defs/id"
        },
        "sourceTableId": {
          "$ref": "#/$defs/id"
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/column"
          }
        },
        "rowCount": {
          "type": "integer",
          "minimum": 0
        },
        "transformations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transformation"
          }
        }
      },
      "additionalProperties": false
    },
    "relationship": {
      "type": "object",
      "required": [
        "id",
        "fromTableId",
        "fromColumn",
        "toTableId",
        "toColumn",
        "cardinality",
        "filterDirection",
        "active"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "fromTableId": {
          "$ref": "#/$defs/id"
        },
        "fromColumn": {
          "type": "string"
        },
        "toTableId": {
          "$ref": "#/$defs/id"
        },
        "toColumn": {
          "type": "string"
        },
        "cardinality": {
          "enum": [
            "one-to-one",
            "one-to-many",
            "many-to-one",
            "many-to-many"
          ]
        },
        "filterDirection": {
          "enum": [
            "single",
            "both"
          ]
        },
        "active": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "measure": {
      "type": "object",
      "required": [
        "id",
        "name",
        "tableId",
        "expression",
        "format"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "tableId": {
          "$ref": "#/$defs/id"
        },
        "expression": {
          "type": "string"
        },
        "format": {
          "enum": [
            "number",
            "integer",
            "currency",
            "percent",
            "text"
          ]
        }
      },
      "additionalProperties": false
    },
    "query": {
      "type": "object",
      "required": [
        "id",
        "name",
        "sql",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "sql": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "report": {
      "type": "object",
      "required": ["id", "name", "pages"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "pages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/page"
          }
        }
      },
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "required": ["id", "name", "visuals", "filters"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "visuals": { "type": "array", "items": { "$ref": "#/$defs/visual" } },
        "filters": { "type": "array", "items": { "$ref": "#/$defs/pageFilter" } }
      },
      "additionalProperties": false
    },
    "pageFilter": {
      "type": "object",
      "required": ["id", "tableId", "column", "operator"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "tableId": { "$ref": "#/$defs/id" },
        "column": { "type": "string", "minLength": 1 },
        "operator": { "$ref": "#/$defs/filterOperator" },
        "value": {},
        "secondValue": {},
        "temporary": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "visual": {
      "type": "object",
      "required": ["id", "title", "type", "tableId"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "type": { "enum": ["table", "kpi", "bar", "horizontalBar", "line", "area", "pie", "donut", "scatter", "slicer"] },
        "tableId": { "$ref": "#/$defs/id" },
        "categoryField": { "type": "string", "minLength": 1 },
        "seriesField": { "type": "string", "minLength": 1 },
        "valueField": { "type": "string", "minLength": 1 },
        "measureId": { "$ref": "#/$defs/id" },
        "aggregation": { "enum": ["none", "count", "countDistinct", "sum", "avg", "min", "max"] },
        "columns": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "limit": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "width": { "type": "integer", "minimum": 1, "maximum": 12 },
        "height": { "type": "integer", "minimum": 2, "maximum": 12 },
        "sortField": { "type": "string", "minLength": 1 },
        "sortBy": { "enum": ["auto", "category", "value"] },
        "sortDirection": { "enum": ["asc", "desc"] },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "backgroundColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "showLegend": { "type": "boolean" },
        "legendPosition": { "enum": ["top", "right", "bottom", "left"] },
        "showLabels": { "type": "boolean" },
        "smooth": { "type": "boolean" },
        "numberFormat": { "$ref": "#/$defs/displayFormat" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 6 },
        "interactionMode": { "enum": ["filter", "none"] }
      },
      "additionalProperties": false
    },
    "theme": {
      "type": "object",
      "required": ["name", "primaryColor", "palette"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "primaryColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "backgroundColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "palette": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
        }
      },
      "additionalProperties": false
    }
  }
}
